DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ihobbyworld"
APP_CURRENCY="INR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public demo deployment only. Leave as production for regular deployments.
DEPLOYMENT_MODE="production"
# Used once by npm run demo:bootstrap when the database has no administrator.
# Supply a unique password of at least 12 characters. Never commit real values.
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_ADMIN_NAME="Demo Administrator"

# Optional Clerk auth. If unset, first-party email/password auth is used.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# AI provider selection: gemini, deepseek, groq, huggingface, or mock.
AI_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_PRICING_MODEL="gemini-3.8-flash"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_PRICING_MODEL="openai/gpt-oss-20b"
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="openai/gpt-oss-20b"
AI_REQUEST_TIMEOUT_MS="15000"

# Object storage. If unset, uploads are saved locally under public/uploads/listings.
# Supports S3-compatible endpoints such as AWS S3, Cloudflare R2, or MinIO.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""

# Email delivery. If unset, user-facing actions log mock email events.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_PASSWORD is also accepted for providers that use this variable name.
SMTP_FROM=""
SMTP_SECURE="false"
